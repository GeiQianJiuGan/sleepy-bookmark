# 小程序访问后端用的域名（需已备案并配置到小程序后台的 request / downloadFile 合法域名）
DOMAIN=your-domain.example
PUBLIC_URL=https://your-domain.example

# 小程序的 AppID 和 AppSecret，用于 wx.login 换取 openid
WX_APPID=
WX_SECRET=

# 允许登录的 openid，逗号分隔；留空时只有第一个登录的微信号能用（被拒绝时接口会返回对方的 openid）
OPENID_WHITELIST=

# 留空则自动生成并保存在 data/jwt.secret
JWT_SECRET=

PREFETCH_AHEAD=5
REFRESH_INTERVAL_MINUTES=180
IMG_CACHE_MAX_MB=2048
