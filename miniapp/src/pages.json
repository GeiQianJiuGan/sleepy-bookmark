{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    { "path": "pages/shelf/shelf", "style": { "navigationBarTitleText": "书架", "enablePullDownRefresh": true } },
    { "path": "pages/search/search", "style": { "navigationBarTitleText": "搜索" } },
    { "path": "pages/mine/mine", "style": { "navigationBarTitleText": "我的" } },
    { "path": "pages/book/detail", "style": { "navigationBarTitleText": "详情" } },
    { "path": "pages/reader/reader", "style": { "navigationBarTitleText": "阅读" } },
    { "path": "pages/history/history", "style": { "navigationBarTitleText": "浏览历史", "enablePullDownRefresh": true } },
    { "path": "pages/sources/list", "style": { "navigationBarTitleText": "书源管理" } },
    { "path": "pages/sources/edit", "style": { "navigationBarTitleText": "编辑书源" } },
    { "path": "pages/downloads/downloads", "style": { "navigationBarTitleText": "下载与缓存" } }
  ],
  "tabBar": {
    "color": "#8a8a8a",
    "selectedColor": "#c0392b",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      { "pagePath": "pages/shelf/shelf", "text": "书架" },
      { "pagePath": "pages/search/search", "text": "搜索" },
      { "pagePath": "pages/mine/mine", "text": "我的" }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "sleepy-bookmark",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f6f3ee"
  }
}
